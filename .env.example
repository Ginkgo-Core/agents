COMPOSE_PROJECT_NAME=ginkgo-agents
TZ=America/Sao_Paulo
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=ginkgo_agents
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ginkgo_agents
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ginkgo_agents:CHANGE_ME@postgres:5432/ginkgo_agents

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_URL=redis://default:CHANGE_ME@redis:6379/1

# n8n
N8N_IMAGE=n8nio/n8n:2
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_WORKER_CONCURRENCY=5
N8N_API_KEY=
N8N_AGENT_DISPATCH_WEBHOOK=http://n8n:5678/webhook/agent-dispatch
N8N_TOOL_DISPATCH_WEBHOOK=http://n8n:5678/webhook/tool-dispatch
N8N_EVENT_DISPATCH_WEBHOOK=http://n8n:5678/webhook/event-dispatch

# Control Plane
CONTROL_PLANE_PORT=8088
INTERNAL_SERVICE_TOKEN=CHANGE_ME
APPROVAL_TTL_MINUTES=60
MAX_JOB_ATTEMPTS=3

# LiteLLM / modelos
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
LITELLM_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME
FAST_MODEL=gemini/gemini-2.5-flash-lite
REASONING_MODEL=gemini/gemini-2.5-flash
EMBEDDING_MODEL=gemini/text-embedding-004
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Hermes
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_API_KEY=CHANGE_ME_MIN_8_CHARS
HERMES_DASHBOARD=1
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME
HERMES_DASHBOARD_SECRET=CHANGE_ME

# Evolution API / WhatsApp
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.0
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_INSTANCE=callima

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_CALLIMA_AGENT_ID=
ELEVENLABS_NYRA_AGENT_ID=
ELEVENLABS_ALFRED_AGENT_ID=
ELEVENLABS_CALLIMA_VOICE_ID=
ELEVENLABS_NYRA_VOICE_ID=
ELEVENLABS_ALFRED_VOICE_ID=

# Datacrazy
DATACRAZY_BASE_URL=
DATACRAZY_API_KEY=
DATACRAZY_WORKSPACE_ID=
DATACRAZY_PIPELINE_ID=

# Nyra / mídia
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_API_KEY=
COMFYUI_IMAGE_WORKFLOW_ID=
COMFYUI_VIDEO_WORKFLOW_ID=
GEMINI_MEDIA_ENABLED=true
MEDIA_STORAGE_MODE=filesystem
MEDIA_DIRECTORY=/app/data/media

# Social APIs
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Alfred / Ads e atribuição
META_AD_ACCOUNT_ID=
TIKTOK_AD_ACCOUNT_ID=
UTMIFY_BASE_URL=
UTMIFY_API_TOKEN=
ALFRED_MAX_DAILY_BUDGET_CHANGE_PERCENT=20
ALFRED_MUTATIONS_ENABLED=false

# MinIO opcional
MINIO_ROOT_USER=ginkgo
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
